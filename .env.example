# Core identity
MARVIN_APP_NAME=marvin-assistant-app

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=gpt-oss-3
GROQ_LLM_TEMPERATURE=0.2
GROQ_LLM_MAX_TOKENS=256
GROQ_STT_MODEL_PRIMARY=whisper-large-v3-turbo
GROQ_STT_MODEL_FALLBACK=whisper-large-v3
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=tara
GROQ_REQUEST_TIMEOUT_SECONDS=20

# Retry / resilience
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.25
RETRY_MAX_DELAY_SECONDS=2.0
RETRY_TIMEOUT_SECONDS=20

# Audio
AUDIO_INPUT_SAMPLE_RATE=48000
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BLOCK_SIZE=1024
AUDIO_SILENCE_THRESHOLD=0.015
AUDIO_SILENCE_DURATION_SECONDS=0.8
AUDIO_MAX_PHRASE_SECONDS=8.0
AUDIO_MIN_PHRASE_SECONDS=0.35
AUDIO_PREROLL_SECONDS=0.25
AUDIO_NORMALIZE_AUDIO=true
AUDIO_TTS_CHUNK_MAX_CHARS=200
AUDIO_PLAYBACK_DEVICE=
AUDIO_INPUT_DEVICE=
AUDIO_TEMP_DIR=.cache/audio

# Robot
ROBOT_BASE_URL=http://192.168.1.100
ROBOT_TIMEOUT_SECONDS=5
ROBOT_MOCK_MODE=true

# Logging
LOGGING_LEVEL=INFO
LOGGING_JSON=true

# Features
FEATURES_VOICE_ENABLED=true
FEATURES_WAKE_WORD_MODE=false
FEATURES_WAKE_WORD=hey marvin
FEATURES_DEMO_MODE=false
FEATURES_STREAM_LLM=false

# Metrics
METRICS_ENABLED=true
